# .env.local 로 복사해서 값을 채워 주세요. 이 파일에는 실제 값을 절대 적지 마세요.
# NEXT_PUBLIC_ 으로 시작하는 것만 브라우저에 노출돼요. 나머지는 전부 서버 전용이에요.

# ── Supabase (대시보드 > Project Settings > API Keys) ──
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). 브라우저에 노출돼도 되는 키예요.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). 서버 전용(계정 삭제·결제 확정·AI 코칭 차감). 절대 NEXT_PUBLIC_ 으로 시작하게 바꾸지 마세요.
SUPABASE_SECRET_KEY=

# ── 토스페이먼츠 크레딧 구매(결제위젯 연동 키, test_gck / test_gsk) ──
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 서버 전용
TOSS_SECRET_KEY=

# ── 토스페이먼츠 월 요금제 정기결제(API 개별 연동 키, test_ck / test_sk) ──
NEXT_PUBLIC_TOSS_BILLING_CLIENT_KEY=
# 서버 전용
TOSS_BILLING_SECRET_KEY=

# ── 정기결제 크론(/api/billing/cron 의 Bearer 토큰). 아무 긴 난수, 서버 전용 ──
CRON_SECRET=

# ── 카카오 어드민 키(계정 삭제 때 카카오 연결 끊기). 서버 전용, 없으면 연결 끊기를 건너뛰어요 ──
KAKAO_ADMIN_KEY=

# ── AI 대본 코칭(전부 서버 전용, NEXT_PUBLIC_ 금지) ──
# Anthropic API 키
ANTHROPIC_API_KEY=
# promo(기본, 테스트: 유료 요금제 + 프로모션 코드 1회) | credits(정식: 대본 길이별 3/6/9크레딧) | off(끔)
AI_COACH_MODE=promo
# 프로모션 코드 목록. 쉼표로 구분, 소문자·숫자 8자리, 대소문자 무시. 예: abcd1234,wxyz5678
AI_PROMO_CODES=

# ── 확인용 계정(로컬 개발·자동 확인 전용. Vercel 에는 넣지 마세요) ──
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
