# Supabase 대시보드 > Project Settings > API Keys 에서 복사해 .env.local 에 넣어 주세요.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). 브라우저에 노출돼도 되는 키예요.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). 서버 전용(계정 삭제). 절대 NEXT_PUBLIC_ 으로 시작하게 바꾸지 마세요.
SUPABASE_SECRET_KEY=

# 토스페이먼츠 주문서형·결제창형 연동 키 테스트 클라이언트 키
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 토스페이먼츠 주문서형·결제창형 연동 키 테스트 시크릿 키
TOSS_SECRET_KEY=

# 토스페이먼츠  테스트 API 개별연동키 테스트 클라이언트 키
NEXT_PUBLIC_TOSS_BILLING_CLIENT_KEY=
# 토스페이먼츠 테스트 API 개별연동키 테스트 시크릿 키
TOSS_BILLING_SECRET_KEY=

CRON_SECRET=

# 카카오 어드민 키
KAKAO_ADMIN_KEY=

# AI anthropic key
ANTHROPIC_API_KEY=

# 확인용 계정(개발·자동 확인 전용, 지우지 않고 계속 씀)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
